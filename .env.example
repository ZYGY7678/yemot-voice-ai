# חובה (Required)
GEMINI_API_KEYS=your_google_gemini_api_key
YEMOT_API_KEY=your_yemot_token_here
DASHBOARD_PASSWORD=1234
PUBLIC_BASE_URL=https://your-service-name.onrender.com

# הגדרות מודלים וזמנים (Models & Timeouts)
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
PER_MODEL_TIMEOUT_MS=20000
REQUEST_TIMEOUT_MS=55000
MODEL_COOLDOWN_MS=3600000

# אופציונלי (Optional)
AI_SYSTEM_INSTRUCTION=
WELCOME_MESSAGE=
SUPABASE_URL=
SUPABASE_KEY=
PORT=3000